# Local PostgreSQL connection (start it with `docker compose up -d`).
# Set POSTGRES_SSL=require for hosted databases that require TLS.
POSTGRES_URL=postgres://postgres:postgres@localhost:5433/nextjs_dashboard
POSTGRES_SSL=false
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=postgres
POSTGRES_HOST=
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=nextjs_dashboard

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth